$name = "Bone";
$numberOfProcessors = 1;
$numberOfIterations = 10;


for($rank=0; $rank < $numberOfProcessors; $rank=$rank+1)
   {
   $filename = sprintf("./%s_1.part%d.exnode", $name, $rank);
   gfx read node "$filename";
   $filename = sprintf("./%s_1.part%d.exelem", $name, $rank);
   gfx read elem "$filename";
   }

gfx def faces egroup $name;

gfx create window 1 double_buffer;
gfx modify window 1 image scene default infinite_viewer_lighting two_sided_lighting;
gfx modify window 1 image add_light default;
gfx modify window 1 image add_light default_ambient;
gfx modify window 1 layout 2d ortho_axes z -y eye_spacing 0.25 width 500 height 500;
gfx modify window 1 set current_pane 1;
gfx modify window 1 background colour 0 0 0 texture none;
gfx modify window 1 view parallel eye_point 10.0 5.0 45.0 interest_point 10.0 5.0 0.0 up_vector 0.0 1.0 0.0 view_angle 40.0 near_clipping_plane 2.0 far_clipping_plane 100.0 relative_viewport ndc_placement -1 1 2 2 viewport_coordinates 0 0 1 1;
gfx modify window 1 set transform_tool current_pane 1 std_view_angle 40 normal_lines no_antialias depth_of_field 0.0 fast_transparency blend_normal;

gfx create spectrum StructureSpectrum
gfx modify spectrum StructureSpectrum clear overwrite
gfx modify spectrum StructureSpectrum linear range 0.25 0.75 extend_above extend_below white_to_blue colour_range 0 1 component 1;

gfx modify g_element $name general clear 
gfx modify g_element $name node_points glyph sphere general size "0.025*0.025*0.025" centre 0,0,0 font default label cmiss_number select_on material blue selected_material default_selected;
gfx modify g_element $name line select_on material white selected_material default_selected render_shaded;
gfx modify g_element $name surfaces domain_mesh2d coordinate Geometry material default data Str spectrum StructureSpectrum


for($iteration=1; $iteration < $numberOfIterations; $iteration=$iteration+1)
{
	for($rank=0; $rank < $numberOfProcessors; $rank=$rank+1)
  	{	
  		$filename = sprintf("%s_%d.part%d.exnode", $name, $iteration, $rank);
  		print "Reading $filename\n";
  		gfx read node $filename;
  		$filename = sprintf("%s_%d.part%d.exelem", $name, $iteration, $rank);
  		print "Reading $filename\n";
  		gfx read elem $filename;
  		$filename = sprintf("%s_%02d.jpg", $name, $iteration);
  		print "Writing $filename\n";
		gfx print file $filename jpg window 1 height 1000 width 1000;
	}
}
